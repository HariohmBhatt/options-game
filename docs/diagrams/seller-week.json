  "cards": [
    {
      "dot": "cyan",
      "title": "Selling one option (rounds 1–3)",
      "items": [
        "You sell at the bid and receive the premium × 65 up front",
        "Margin ≈ 8% of notional ≈ ₹1,24,800 per lot at NIFTY 24,000 stays blocked until you close",
        "STT 0.15% is paid on the sell order; brokerage ₹20 per order"
      ]
    },
    {
      "dot": "amber",
      "title": "Each day while holding",
      "items": [
        "Theta earns you ₹ per day as time value melts",
        "A NIFTY move against you costs ₹ per point",
        "A VIX rise costs ₹ per VIX point"
      ]
    },
    {
      "dot": "rose",
      "title": "Gap day",
      "items": [
        "NIFTY opens −3.2% and VIX jumps ×1.6",
        "Naked: the mark-to-market loss is many times the premium; you are still holding, or it settles in the money",
        "Spread: the bought option caps the loss at (width − credit) × 65"
      ]
    },
    {
      "dot": "violet",
      "title": "Ways a round ends",
      "items": [
        "Buy back at the ask any day: Closed",
        "Expires out of the money: you keep the full premium",
        "Expires in the money: you pay intrinsic × 65 (no STT for the seller)",
        "Capped (grey): the spread's bought leg, or your own buy-back, stops the loss"
      ]
    },
    {
      "dot": "emerald",
      "title": "Result card",
      "items": [
        "Premium received · buy-back or settlement · charges · net · return on margin",
        "Five rounds: three naked, then two hedged spreads (width 100 or 200)",
        "Spread margin ≈ max loss × 1.1, so the return on margin compares fairly",
        "Summary is the only terminal state (double border)"
      ]
    }
