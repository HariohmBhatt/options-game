  "cards": [
    {
      "dot": "emerald",
      "title": "Bought at 150, sold at 170 (mid)",
      "items": [
        "You buy at the ask, 150.15, and sell at the bid, 169.80: ₹10 + ₹13 of the move goes to market makers.",
        "Gross P/L (169.80 − 150.15) × 65 = +₹1,277.",
        "Charges ₹28 + ₹45 = ₹73. Net = +₹1,205."
      ]
    },
    {
      "dot": "orange",
      "title": "Charges, order by order",
      "items": [
        "Buy ₹28: brokerage ₹20, exchange ₹3.42, SEBI ₹0.01, stamp ₹0.29, GST ₹4.22.",
        "Sell ₹45: brokerage ₹20, STT ₹16.56, exchange ₹3.86, SEBI ₹0.01, GST ₹4.30.",
        "GST is 18% of brokerage + exchange + SEBI. No STT on the buy, no stamp duty on the sell."
      ]
    },
    {
      "dot": "slate",
      "title": "Or held to expiry, in the money",
      "items": [
        "Cash settlement pays intrinsic × 65: 170 points = ₹11,050.",
        "STT 0.15% of that, ₹17. No brokerage, no exchange charge.",
        "Net = ₹11,050 − ₹9,760 − ₹28 − ₹17 = +₹1,246."
      ]
    }
  ]
