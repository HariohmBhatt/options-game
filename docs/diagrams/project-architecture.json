  "cards": [
    {
      "dot": "cyan",
      "title": "Player path",
      "items": [
        "Hub → game page → logic.js → market.js / engine.js → localStorage",
        "Every page links style.css and loads engine.js + market.js with <script>",
        "Hub badges read Engine.progress; a finished game calls progress.done",
        "Each game keeps its bankroll and the round in progress under optionsgames.<game>.*, so a reload resumes"
      ]
    },
    {
      "dot": "amber",
      "title": "The five games",
      "items": [
        "ticket: NIFTY Weekly · payoff: Payoff Painter · expiry: Expiry Tuesday · chain: Read the Chain · seller: Seller's Week",
        "Same shape each: index.html renders and saves, logic.js holds the rules, test/<game>.test.js checks them in node"
      ]
    },
    {
      "dot": "emerald",
      "title": "Contributor path",
      "items": [
        "npm test runs each test/*.js with node assert; tests require logic.js, market.js and engine.js",
        "e2e/run.js plays scenarios like a person and records videos, screenshots and report.md",
        "CI runs unit tests, then e2e in Chromium and WebKit, and uploads e2e/artifacts"
      ]
    },
    {
      "dot": "slate",
      "title": "Hosting",
      "items": [
        "No build, no backend, no network calls at runtime: open index.html or serve the folder statically",
        "README says GitHub Pages works; this repo has no deploy workflow"
      ]
    }
  ]
}
