    },
    {
      "id": "blocked",
      "type": "waiting",
      "icon": "stop",
      "label": "Buy blocked",
      "sublabel": "not enough bankroll",
      "tag": "retry"
    },
    {
      "id": "holding",
      "type": "active",
      "icon": "briefcase",
      "label": "Holding",
      "sublabel": "time value melts",
      "tag": "Greeks chips in ₹",
      "step": "2"
    },
    {
      "id": "sold",
      "type": "neutral",
      "icon": "stop",
      "label": "Sold",
      "sublabel": "at the bid",
      "tag": "STT on sell",
      "step": "3"
    },
    {
      "id": "settled",
      "type": "success",
      "icon": "success",
      "label": "Settled in cash",
      "sublabel": "ITM: intrinsic × 65",
