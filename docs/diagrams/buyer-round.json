  "cards": [
    {
      "dot": "violet",
      "title": "What happens on each arrow",
      "items": [
        "Choosing shows your max loss as a % of your bankroll before you buy",
        "Buy at the ask: premium × 65 × lots leaves your bankroll",
        "Each day (Game 1) or tick (Game 3): repriced at the new NIFTY level, with less time left and the new VIX",
        "Greeks chips while holding: ₹ per NIFTY point, ₹ per day (or hour), ₹ per VIX point",
        "Sell at the bid any time, or hold through Tuesday 15:30 to settle in cash or lapse",
        "Game 3: watched to 15:30 without buying = no trade today, nothing spent"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reading the result card",
      "items": [
        "P/L split: NIFTY moved · time passed · VIX changed · spread + charges",
        "\"Biggest factor\" names the part that moved your P/L most",
        "Lot is 65 units; NIFTY options expire Tuesday 15:30 and settle in cash"
      ]
    },
    {
      "dot": "amber",
      "title": "Saved, blocked and waiting",
      "items": [
        "Reload at any point: you resume the same state (saved in this browser)",
        "Not enough bankroll: the buy button is blocked until you pick fewer lots or a cheaper strike",
        "Game 3: watch +5 or +30 minutes before buying, or let 15:30 pass with no trade"
      ]
    },
    {
      "dot": "rose",
      "title": "What each trade costs",
      "items": [
        "You buy at the ask and sell at the bid",
        "Brokerage ₹20 per order; STT 0.15% on the sell premium",
        "Held to expiry in the money: STT 0.15% on the intrinsic value instead"
      ]
    },
    {
      "dot": "emerald",
      "title": "After the summary",
      "items": [
        "Summary is the only terminal state (double border)",
        "Play again: five new rounds, same bankroll",
        "Start over: bankroll resets to the starting amount"
      ]
    }
