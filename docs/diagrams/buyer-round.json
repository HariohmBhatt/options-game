      "label": "Result card",
      "sublabel": "P/L split by cause",
      "tag": "Biggest factor",
      "step": "4"
    },
    {
      "id": "summary",
      "type": "decision",
      "icon": "calendar",
      "label": "Summary",
      "sublabel": "bankroll, lessons",
      "tag": "terminal",
      "step": "5"
