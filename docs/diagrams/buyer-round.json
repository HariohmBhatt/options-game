{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "One round as an option buyer: NIFTY Weekly and Expiry Tuesday",
    "locale": "en",
    "output": "docs/diagrams/buyer-round.html",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "start": {
          "label": "Start"
        },
        "waiting": {
          "label": "Waiting"
        },
        "active": {
          "label": "Trade open"
        },
        "neutral": {
          "label": "Sold early"
        },
        "success": {
          "label": "Settled in cash"
        },
        "failure": {
          "label": "Worthless"
        },
        "decision": {
          "label": "Score card"
        }
      }
    }
